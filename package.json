{
  "name": "wmealplan",
  "version": "1.0.0",
  "description": "AI-powered weekly meal prep planner with grocery lists",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd client && npm start",
    "server": "nodemon server.js",
    "build": "cd client && npm run build",
    "deploy": "npm install && cd client && npm install && npm run build",
    "vercel-build": "npm install && cd client && npm install && npm run build"
  },
  "keywords": [
    "meal-prep",
    "recipe",
    "grocery-list",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@vercel/postgres": "^0.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonrepair": "^3.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
